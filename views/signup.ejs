<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>Signup | Blogify</title>
  </head>

  <body class="bg-body-tertiary">
    <%- include('./partials/nav') %>

    <div class="container py-5">
      <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
          <div class="card shadow border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
              <div class="text-center mb-4">
                <div
                  class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-3 mb-3"
                >
                  <i class="bi bi-person-plus-fill fs-3"></i>
                </div>
                <h3 class="fw-bold mb-1">Create Account</h3>
                <p class="text-body-secondary small">
                  Join Blogify and start sharing your stories
                </p>
              </div>

              <form action="/user/signup" method="post">
                <div class="form-floating mb-3">
                  <input
                    type="text"
                    class="form-control rounded-3"
                    id="fullName"
                    name="fullName"
                    placeholder="Enter your full name"
                    required
                  />
                  <label for="fullName">Full Name</label>
                </div>

                <div class="form-floating mb-3">
                  <input
                    type="email"
                    name="email"
                    class="form-control rounded-3"
                    id="exampleInputEmail1"
                    placeholder="name@example.com"
                    required
                  />
                  <label for="exampleInputEmail1">Email Address</label>
                  <div id="emailHelp" class="form-text ms-1 mt-1 small">
                    <i class="bi bi-shield-lock me-1"></i>We'll never share your
                    email with anyone else.
                  </div>
                </div>

                <div class="form-floating mb-4">
                  <input
                    name="password"
                    type="password"
                    class="form-control rounded-3"
                    id="exampleInputPassword1"
                    placeholder="Create a password"
                    required
                  />
                  <label for="exampleInputPassword1">Password</label>
                </div>

                <div class="d-grid mb-4">
                  <button
                    type="submit"
                    class="btn btn-primary btn-lg rounded-pill fw-medium shadow-sm"
                  >
                    Create Account
                  </button>
                </div>

                <div class="text-center small text-body-secondary mt-3">
                  Already have an account?
                  <a
                    href="/user/signin"
                    class="text-decoration-none fw-semibold ms-1"
                  >
                    Sign in here
                  </a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%- include('./partials/scripts') %>
  </body>
</html>
