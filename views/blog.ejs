<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title><%= blog.title %> | Blogify</title>

   
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

    <style>
    
      .blog-container {
        max-width: 760px; 
        margin: 0 auto;
      }

      /* Article Header */
      .article-title {
        font-family: 'Inter', sans-serif;
        font-weight: 800;
        font-size: clamp(2rem, 5vw, 3rem); 
        line-height: 1.2;
        letter-spacing: -0.03em;
      }

      
      .blog-content {
        font-family: 'Lora', serif; 
        font-size: 1.25rem;
        line-height: 1.9;
        white-space: pre-wrap; 
        word-break: break-word;
      }

     
      .comment-textarea:focus {
        box-shadow: none;
        border-color: var(--bs-primary);
      }
    </style>
  </head>

  <body class="bg-body-tertiary d-flex flex-column min-vh-100">

    <%- include('./partials/nav') %>

  
    <main class="flex-grow-1 bg-body py-5 shadow-sm">
      <article class="container blog-container">

      
        <h1 class="article-title text-body-emphasis mb-4">
          <%= blog.title %>
        </h1>

    
        <div class="d-flex align-items-center mb-5 pb-2">
          <img
            src="<%= blog.createdBy.profileImageURL %>"
            class="rounded-circle object-fit-cover shadow-sm border border-2 border-body-secondary me-3"
            width="52"
            height="52"
            alt="<%= blog.createdBy.fullName %>"
          />
          <div>
            <div class="fw-bold text-body fs-6">
              <%= blog.createdBy.fullName %>
            </div>
            <small class="text-body-secondary text-uppercase fw-semibold" style="letter-spacing: 0.5px; font-size: 0.75rem;">
              Author
            </small>
          </div>
        </div>

    
        <img
          src="<%= blog.coverImageURL %>"
          class="w-100 rounded-4 shadow-sm mb-5 object-fit-cover"
          style="max-height: 460px;"
          alt="Cover image for <%= blog.title %>"
        />


        <div class="blog-content text-body mb-5">
<%= blog.body %>
        </div>

      </article>
    </main>

    
    <section class="bg-body-tertiary py-5 border-top border-secondary-subtle">
      <div class="container blog-container">

        <h3 class="fw-bold mb-4 text-body-emphasis d-flex align-items-center gap-2">
          Responses <span class="badge bg-secondary rounded-pill fs-6"><%= comments.length %></span>
        </h3>

        <% if (locals.user) { %>

        
        <form action="/blog/comment/<%= blog._id %>" method="post" class="mb-5">
          <div class="card border-0 shadow-sm rounded-4 bg-body">
            <div class="card-body p-3 p-md-4">
              <div class="d-flex gap-3">
                <img src="<%= locals.user.profileImageURL %>" class="rounded-circle object-fit-cover d-none d-sm-block" width="44" height="44" alt="You">
                <div class="flex-grow-1">
                  <textarea
                    name="content"
                    class="form-control comment-textarea bg-body-tertiary border-secondary-subtle rounded-3 p-3 mb-3"
                    rows="3"
                    placeholder="What are your thoughts?"
                    required
                  ></textarea>
                  <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-medium shadow-sm">
                      Post Response
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </form>

        <% } else { %>
         
          <div class="alert bg-body border border-secondary-subtle text-center mb-5 rounded-4 py-4 shadow-sm">
            <p class="text-body-secondary mb-3">Join the conversation. Share your thoughts with the community.</p>
            <a href="/user/signin" class="btn btn-outline-primary rounded-pill fw-medium px-4">Sign in to respond</a>
          </div>
        <% } %>

        
        <div class="d-flex flex-column gap-4">
          <% comments.forEach(comment => { %>

          <div class="d-flex align-items-start gap-3">
            <img
              src="<%= comment.createdBy.profileImageURL %>"
              class="rounded-circle object-fit-cover shadow-sm border border-secondary-subtle mt-1"
              width="44"
              height="44"
              alt="<%= comment.createdBy.fullName %>"
            />
            
            <div class="flex-grow-1 bg-body p-3 p-md-4 rounded-4 shadow-sm border border-secondary-subtle">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="fw-bold text-body-emphasis">
                  <%= comment.createdBy.fullName %>
                </div>
              </div>
              
              <div class="text-body" style="white-space: pre-wrap; line-height: 1.6;">
<%= comment.content %>
              </div>
            </div>
          </div>

          <% }) %>
        </div>

      </div>
    </section>

    <%- include('./partials/scripts') %>

  </body>
</html>