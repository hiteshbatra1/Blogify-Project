<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>Homepage | Blogify</title>
    <style>
      
      
      
      .blog-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid rgba(0,0,0,0.08);
        
        
        cursor: pointer; 
        
        
        transform: translateZ(0);
        backface-visibility: hidden;
      }

      
      .blog-card::before {
        content: "";
        position: absolute;
        inset: -15px; 
        z-index: -1;
      }

      .blog-card:hover {
        transform: translateY(-5px) translateZ(0);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
      }
      
      [data-bs-theme="dark"] .blog-card {
        border-color: rgba(255,255,255,0.1);
      }
      [data-bs-theme="dark"] .blog-card:hover {
        box-shadow: 0 15px 30px rgba(0,0,0,0.4) !important;
      }

      
      .card-img-wrapper {
        overflow: hidden;
      }
      .card-img-wrapper img {
        transition: transform 0.5s ease;
      }
      .blog-card:hover .card-img-wrapper img {
        transform: scale(1.05);
      }
    
      
      .text-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .text-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      
      .hero-section {
        background: linear-gradient(135deg, rgba(var(--bs-primary-rgb), 0.1) 0%, rgba(var(--bs-body-bg-rgb), 1) 100%);
        border-radius: 1.5rem;
      }
    </style>
  </head>

  <body class="bg-body-tertiary d-flex flex-column min-vh-100">

    <%- include('./partials/nav') %>

    <div class="container py-4 flex-grow-1">

      <!-- Hero & Search Section -->
      <div class="hero-section text-center p-5 mb-5 shadow-sm">
        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill mb-3 fw-semibold">
          <i class="bi bi-stars me-1"></i> Discover Blogify
        </span>
        <h1 class="fw-bold display-5 text-body-emphasis mb-3">Welcome to the Community</h1>
        <p class="text-body-secondary fs-5 col-md-8 mx-auto mb-4">
          Explore fresh ideas, inspiring stories, and technical insights from our diverse group of writers.
        </p>
      </div>

     
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-body-emphasis m-0">Latest Articles</h3>
      </div>

      <div class="row g-4 mb-5">
        <% if (blogs && blogs.length > 0) { %>
          <% blogs.forEach(blog => { %>
            <div class="col-sm-6 col-md-4 col-lg-3">
              <div class="card blog-card h-100 rounded-4 bg-body text-start position-relative">
                
                
                <div class="card-img-wrapper rounded-top-4">
                  <img
                    src="<%= blog.coverImageURL || '/images/default-blog.jpg' %>"
                    class="card-img-top w-100 object-fit-cover"
                    style="height: 200px;"
                    alt="<%= blog.title %>"
                  />
                </div>

                <div class="card-body d-flex flex-column p-4">
               
                  <div class="text-muted small mb-2 d-flex align-items-center gap-2">
                    <i class="bi bi-calendar3"></i> 
                    <span><%= new Date(blog.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                  </div>

                 
                  <h5 class="card-title fw-bold text-body-emphasis mb-2 text-clamp-2" title="<%= blog.title %>">
                    <%= blog.title %>
                  </h5>

               
                  <p class="card-text text-body-secondary small mb-4 text-clamp-3">
                    <%= blog.body ? blog.body.replace(/<[^>]+>/g, '') : 'Click to read more about this topic...' %>
                  </p>

                  
                  <div class="mt-auto d-flex align-items-center justify-content-between border-top pt-3">
                    
                   
                    <div class="d-flex align-items-center gap-2">
                      <img src="<%= user?.profileImageURL || '/images/default-avatar.png' %>" alt="Author" class="rounded-circle object-fit-cover" width="32" height="32">
                      <span class="small fw-medium text-body-secondary text-truncate" style="max-width: 100px;">
                        <%= user?.fullName || 'Anonymous' %>
                      </span>
                    </div>

                  
                    <a href="/blog/<%= blog._id %>" class="btn btn-sm btn-light text-primary fw-semibold rounded-pill stretched-link">
                      Read <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                  </div>

                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          
          <div class="col-12 text-center py-5">
            <div class="mb-4 text-muted opacity-50">
              <i class="bi bi-journal-x" style="font-size: 4rem;"></i>
            </div>
            <h4 class="fw-bold">No blogs found</h4>
            <p class="text-body-secondary">Check back later or be the first to write an article!</p>
            <a href="<%= user ? '/blog/add-new' : '/user/signin' %>" 
              class="btn btn-primary rounded-pill px-4 py-2 mt-2">
               <i class="bi bi-pencil-square me-2"></i> Write a Blog
            </a>
          </div>
        <% } %>
      </div>

    </div>

    <%- include('./partials/scripts') %>

  </body>
</html>